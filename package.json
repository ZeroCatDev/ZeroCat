{
  "name": "zerocat",
  "version": "1.0.21",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "pnpm run start:backend",
    "start:backend": "pnpm --filter ./apps/api start",
    "submodules:init": "git submodule update --init --recursive",
    "submodules:sync": "git submodule sync --recursive",
    "submodules:update": "git submodule update --remote --recursive",
    "prisma": "pnpm --filter ./apps/api prisma",
    "prisma:pull": "pnpm --filter ./apps/api prisma:pull",
    "build": "pnpm run build:backend",
    "build:backend": "pnpm --filter ./apps/api build",
    "build:frontend": "pnpm --filter ./apps/web build",
    "build:all": "turbo run build",
    "dev": "pnpm run dev:backend",
    "dev:backend": "pnpm --filter ./apps/api dev",
    "dev:no": "pnpm --filter ./apps/api dev:no",
    "dev:frontend": "pnpm --filter ./apps/web dev",
    "dev:all": "turbo run dev",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "test:dependencies": "node --test scripts/dependencies.test.js",
    "test:permissions": "node scripts/test-token-permissions.js",
    "test:admin-users": "node --experimental-test-module-mocks --test apps/api/src/services/admin/*.test.js apps/api/src/services/auth/tokenService.test.js",
    "test:admin-users:db": "pnpm --filter ./apps/api exec node --import tsx --test src/services/admin/userManagement.integration.test.js",
    "test:community": "node --experimental-test-module-mocks --test apps/api/src/services/auth/authorization*.test.js apps/api/src/services/auth/resourceOperations.test.js apps/api/src/services/auth/delegationService.test.js apps/api/src/services/auth/permissionAdministration.test.js apps/api/src/services/moderation/*.test.js apps/api/src/middleware/scope.test.js apps/api/src/controllers/posts.moderation.test.js apps/api/src/routes/*.test.js apps/api/src/services/gitSync/*.test.js apps/api/src/services/projectCommitAccess.test.js apps/api/src/services/scratchCloudWs.test.js apps/api/src/services/assets.authorization.test.js apps/api/src/services/email/*.test.js apps/web/src/services/permissions.test.js",
    "test:community:db": "pnpm --filter ./apps/api exec node --experimental-test-module-mocks --import tsx --test src/services/moderation/moderation.integration.test.js",
    "dev:blog": "pnpm --filter ./apps/blog dev",
    "build:blog": "pnpm --filter ./apps/blog build"
  },
  "dependencies": {
    "@atproto/api": "^0.19.19",
